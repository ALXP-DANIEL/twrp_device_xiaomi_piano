+// Waits for the stock secure stack to come up before decryption is attempted.
+//
+// The HALs are declared "disabled" in init.recovery.qcom.rc and started by
+// triggers there: qseecomd once the stock vendor mount completes, then KeyMint,
+// Gatekeeper and Weaver once qseecomd announces its listeners through
+// vendor.sys.listeners.registered. Both happen in parallel with TWRP's own
+// start-up, so without a wait Setup_Fstab_Partitions() can ask for the metadata
+// key before KeyMint has registered:
+//
+//   Service android.hardware.security.keymint.IKeyMintDevice/default didn't start
+//   keystore2: failed to get interface ... Retry 4/5: NAME_NOT_FOUND
+//
+// and decryption then fails for want of a HAL rather than for any crypto reason.
+//
+// The waits are bounded and non-fatal. If the stack does not come up, carrying on
+// gives the same failure as before rather than hanging the recovery, and the
+// timeout is logged so it is not mistaken for a crypto fault.
+static void piano_wait_for_secure_stack() {
+	using namespace std::chrono_literals;
+
+	if (!android::base::WaitForProperty("vendor.sys.listeners.registered", "true", 30s)) {
+		LOGERR("piano: QSEE listeners did not register within 30s; decryption will likely fail\n");
+		return;
+	}
+	LOGINFO("piano: QSEE listeners registered\n");
+
+	if (!android::base::WaitForProperty("init.svc.vendor.keymint", "running", 15s)) {
+		LOGERR("piano: KeyMint HAL did not start within 15s; decryption will likely fail\n");
+		return;
+	}
+	LOGINFO("piano: KeyMint HAL running\n");
+}
