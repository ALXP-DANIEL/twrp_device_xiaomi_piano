# Qualcomm TEE / SMC Invoke
/dev/smcinvoke    u:object_r:tee_device:s0

# Qualcomm secure-storage SSD partition
/dev/block/platform/soc/1d84000\.ufshc/by-name/ssd    u:object_r:vendor_ssd_block_device:s0

# Qualcomm UFS / SCSI secure-storage devices — stock piano labels.
/dev/sg[0-9]+          u:object_r:vendor_sg_device:s0
/dev/ufs-bsg.*         u:object_r:vendor_bsg_device:s0
/dev/0:0:0:4           u:object_r:vendor_ufs_lun4_bsg_device:s0
/dev/0:0:0:49476       u:object_r:vendor_bsg_device:s0

# HyperOS 3 Android 16 compatibility libraries used only by stock qseecomd

# Stock qseecomd packaged for recovery
/vendor/bin/piano-qseecomd    u:object_r:tee_exec:s0

# Stock KeyMint HAL packaged for recovery. The AOSP default KeyMint exec
# type is reused so init performs the standard domain transition into
# hal_keymint_default, whose rules and service labels already exist.

# Qualcomm QSEE DMA heap — stock piano label
/dev/dma_heap/qcom,qseecom    u:object_r:vendor_dmabuf_qseecom_heap_device:s0


# Stock Xiaomi Weaver HAL packaged for recovery. The exec type is declared
# by the device policy because AOSP has no default Weaver implementation.

# Stock KeyMint HAL. The AOSP hal_keymint_default_exec type is reused so init
# performs the standard domain transition into hal_keymint_default, whose
# rules and the four service labels already exist in the platform policy.
/vendor/bin/hw/piano-keymint    u:object_r:hal_keymint_default_exec:s0

# Stock Gatekeeper HAL. Reuses the AOSP hal_gatekeeper_default domain.
/vendor/bin/hw/piano-gatekeeper    u:object_r:hal_gatekeeper_default_exec:s0

# Stock Xiaomi Weaver HAL. hal_weaver_default and its exec type are declared
# by system/sepolicy/vendor/hal_weaver_default.te in the platform policy.
/vendor/bin/hw/piano-weaver    u:object_r:hal_weaver_default_exec:s0

# Qualcomm GlobalPlatform TA loader, packaged from the stock vendor image.
# The AOSP tee_exec type is reused so init performs the standard transition into
# u:r:tee:s0, which already has the smcinvoke, DMA-heap, wakelock and UFS access
# this daemon needs — it talks to the same secure world qseecomd does.
/vendor/bin/piano-ssgtzd    u:object_r:tee_exec:s0
