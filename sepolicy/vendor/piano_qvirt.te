# Xiaomi Pad 8 Pro (piano) — Qualcomm virtualization service.
#
# This service starts the Gunyah guest VM named "trustedvm", which is the
# operating system MiTEE runs inside. Xiaomi's Weaver talks to a trusted
# application hosted there, so until this VM is running there is no secure
# world for the Weaver session to reach, and every attempt fails at the
# transport rather than at anything to do with credentials or keys.
#
# On stock this runs as vendor_hal_qvirtservice_qti, a domain declared in the
# platform policy that is not present here. A private domain is declared
# instead, starting from nothing and growing only against runtime AVCs, the
# same way the tee domain in this tree was built.
type piano_qvirt, domain;
type piano_qvirt_exec, exec_type, vendor_file_type, file_type;

# init starts it; this performs the domain transition on exec.
init_daemon_domain(piano_qvirt)

# It registers vendor.qti.qvirt.IVirtualizationService/default. Without the
# registration succeeding the process aborts on a CHECK and takes the VM launch
# with it:
#   Check failed: status == STATUS_OK (status=-3, STATUS_OK=0)
type piano_qvirt_service, service_manager_type;

add_service(piano_qvirt, piano_qvirt_service)
binder_use(piano_qvirt)

# The Gunyah loader's misc device. Creating, configuring and starting a guest
# VM is entirely ioctl traffic against this node.
type vendor_qgunyah_device, dev_type;

allow piano_qvirt vendor_qgunyah_device:chr_file {
    ioctl
    read
    write
    getattr
    lock
    map
    open
};

# The two VM disks are attached through loopback devices: the read-only root
# filesystem at /product/firmware/vm-system/system.img and the VM's own
# persistent image under /mnt/product/vm-persist.
allow piano_qvirt loop_control_device:chr_file { ioctl read write open getattr };
allow piano_qvirt loop_device:blk_file { ioctl read write open getattr };

# Its config file and the two disk images.
allow piano_qvirt vendor_configs_file:file { read getattr open map };
allow piano_qvirt vendor_configs_file:dir { search getattr open read };

# RUNTIME AVC EVIDENCE (2026-09-15). Four denials from the first boot on which
# the service stayed alive long enough to do any work. It now reports
# "Virtualization service registered" and "autostarthandler: Launching
# trustedvm", so everything below is what the launch path itself needs.

# It opens a uevent listener to learn when VM devices appear:
#   E qvirtservice: uevent_open_socket() failed
#   avc: denied { create } scontext=u:r:piano_qvirt:s0
#        tclass=netlink_kobject_uevent_socket
allow piano_qvirt self:netlink_kobject_uevent_socket { create read write bind getattr setopt getopt };

# It reads sys.boot_completed to decide whether the HLOS is far enough along to
# bring VMs up. In recovery the property never becomes 1, which is fine -- the
# read simply has to be allowed rather than denied.
#   avc: denied { read } name="u:object_r:boot_status_prop:s0"
get_prop(piano_qvirt, boot_status_prop)

# It publishes per-VM status as vendor.qvirtmgr.<name>.status, which requires
# talking to the property service at all:
#   avc: denied { write } name="property_service" tclass=sock_file
set_prop(piano_qvirt, vendor_piano_qvirt_prop)

# RUNTIME AVC EVIDENCE (2026-09-15). The virtualization service does not boot
# the VM itself: it forks /system_ext/bin/qcrosvm, a crosvm-derived virtual
# machine monitor, and that is what opens the Gunyah device and attaches the
# VM's disks. The binary carries vendor_qcrosvm_exec on disk, but the type was
# absent from the recovery policy, so it resolved as unlabeled and exec was
# refused -- the same defect as /data/vendor/tzstorage:
#
#   SELinux: Context u:object_r:vendor_qcrosvm_exec:s0 is not valid (left unmapped)
#   avc: denied { execute } name="qcrosvm" dev="dm-4"
#        tcontext=u:object_r:unlabeled:s0
#        trawcon="u:object_r:vendor_qcrosvm_exec:s0"
#   qvirtservice: trustedvm: launch failed - errno=Permission denied
#
# Stock runs qcrosvm in its own domain. It is kept in piano_qvirt here rather
# than given a second private domain, so that the rules it needs appear as
# denials against one domain and can be granted against evidence. If it turns
# out to need something piano_qvirt should not have, it gets split then.
type vendor_qcrosvm_exec, exec_type, file_type;

allow piano_qvirt vendor_qcrosvm_exec:file { read getattr open map execute execute_no_trans };

# RUNTIME AVC EVIDENCE (2026-09-15). qcrosvm now runs. Three denials from its
# first real execution, all in the path that opens the VM's disks.

# The VM's root filesystem directory carries vendor_vm_qti_system_file on the
# product partition, and the type was absent from the recovery policy, so it
# resolved as unlabeled -- the third instance of this same defect, after
# /data/vendor/tzstorage and /system_ext/bin/qcrosvm:
#
#   avc: denied { search } name="vm-system" dev="dm-1"
#        tcontext=u:object_r:unlabeled:s0
#        trawcon="u:object_r:vendor_vm_qti_system_file:s0"
type vendor_vm_qti_system_file, file_type;

allow piano_qvirt vendor_vm_qti_system_file:dir { search getattr open read };
allow piano_qvirt vendor_vm_qti_system_file:file { read getattr open map lock ioctl };

# It reads ungrouped system properties while setting the VM up.
#   avc: denied { read } name="u:object_r:default_prop:s0"
get_prop(piano_qvirt, default_prop)

# DAC_OVERRIDE. qcrosvm opens the VM images and the Gunyah device while the
# filesystem permissions on the stock mounts do not match the identity it runs
# as. Stock grants this to its own VMM domain for the same reason.
#   avc: denied { dac_override } capability=1
allow piano_qvirt self:capability dac_override;

# OBSERVED LABELS (2026-09-15). Not speculative: qvirtmgr-vndr.json names both
# VM disks by absolute path, so qcrosvm must open both, and these are the
# labels they actually carry on this device.
#
#   /mnt/product/vm-persist/trustedvm/persist.img  mnt_product_file
#   /system_ext/etc/seccomp_policy/qcrosvm.policy  system_file
#
# The system.img on product is covered by vendor_vm_qti_system_file above.
#
# Write is granted on the persist image because the stock config marks it
# "read_write": true. The partition is mounted read-only in this recovery, so
# the filesystem refuses writes regardless of what the policy permits; the rule
# is here so that, if read-only proves to be the blocker, the experiment is one
# mount option rather than another build.
allow piano_qvirt mnt_product_file:dir { search getattr open read };
allow piano_qvirt mnt_product_file:file { read write getattr open map lock ioctl };

# Its seccomp policy file, read at start-up.
allow piano_qvirt system_file:file { read getattr open map };
allow piano_qvirt system_file:dir { search getattr open read };
