# Xiaomi Pad 8 Pro (piano) — bounded MiTEE readiness watcher.
# Reads the stock supplicant's boot-complete property and publishes the Weaver
# startup/fallback result. No module-loading or cross-domain /proc access.
type piano_vmwatch, domain;
type piano_vmwatch_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(piano_vmwatch)

get_prop(piano_vmwatch, vendor_mitee_prop)
set_prop(piano_vmwatch, vendor_piano_vm_prop)
