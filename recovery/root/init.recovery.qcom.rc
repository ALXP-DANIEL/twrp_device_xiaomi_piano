on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1
    setprop vendor.piano.qsee.mount_attempted 0
    # Stock vendor build.prop selects the TZ-backed secure services over
    # SPU with this value. KeyMint and Gatekeeper both read it at startup.
    setprop vendor.gatekeeper.is_security_level_spu 0
    # Stock vendor build.prop value; used by the KeyMint startup retry loop.
    setprop vendor.keymint.retry_timer 5

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on boot
    setprop sys.usb.config adb

# QSEE recovery ramdisk SELinux labels
#
# Ramdisk files are initially rootfs-labeled. Apply the existing Android
# file_contexts narrowly instead of granting tee access to rootfs.
on early-fs
    restorecon /system/etc/task_profiles.json
    restorecon /system/bin
    restorecon /system/bin/linker64
    restorecon /system/etc/ld.config.txt
    restorecon /system/lib64
    restorecon /system/lib64/libc.so
    restorecon /system/lib64/libm.so
    restorecon /system/lib64/libdl.so
    restorecon /system/lib64/ld-android.so
    restorecon /system/lib64/libdl_android.so
    restorecon /system/lib64/libnetd_client.so
    restorecon /system/lib64/libbinder.so
    restorecon /system/lib64/libbinder_ndk.so
    restorecon_recursive /vendor/piano-stock-qsee-system

    # The binder wire protocol must match the running servicemanager, which
    # is TWRP's Android 14 build. Stock Android 16 binder libraries link but
    # every AServiceManager_addService() fails against it, so the recovery's
    # own pair is placed ahead of the stock vendor copies.
    symlink /system/lib64/libbinder.so /vendor/piano-stock-qsee-system/lib64/libbinder.so
    symlink /system/lib64/libbinder_ndk.so /vendor/piano-stock-qsee-system/lib64/libbinder_ndk.so

    restorecon /vendor/bin/piano-qseecomd
    restorecon /vendor/bin/hw/piano-keymint

# Xiaomi Pad 8 Pro host-touch stack
on post-fs
    insmod /vendor/lib/modules/xiaomi_touch.ko
    insmod /vendor/lib/modules/nt36532_touch.ko
    start odm.touch_report

# Xiaomi piano ADSP bootstrap for recovery charging
service piano_adsp_bootstrap /system/bin/sh /system/bin/piano-adsp-bootstrap.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on post-fs
    start piano_adsp_bootstrap

# Stock vendor compatibility mount for QSEE
#
# Keep recovery /vendor untouched. Mount the active-slot stock vendor
# read-only at an alternate path used only by the QSEE compatibility island.
# TWRP creates the logical-partition mapper links after normal post-fs.
on property:twrp.super.symlinks_created=true && property:vendor.piano.qsee.mount_attempted=0
    setprop vendor.piano.qsee.mount_attempted 1
    mkdir /vendor/piano-stock 0755 root root
    wait /dev/block/mapper/vendor${ro.boot.slot_suffix} 5
    mount erofs /dev/block/mapper/vendor${ro.boot.slot_suffix} /vendor/piano-stock ro

    # Recovery-only bootdevice compatibility alias required by stock QSEE.
    symlink /dev/block/platform/soc/1d84000.ufshc /dev/block/bootdevice

# Stock piano Qualcomm TEE daemon
#
# Disabled intentionally. The stock vendor compatibility mount and the
# bootdevice alias are prepared automatically, but qseecomd is started
# manually with: setprop ctl.start vendor.qseecomd
service vendor.qseecomd /vendor/bin/piano-qseecomd
    class core
    user root
    group root drmrpc
    socket notify-topology stream 0660 system drmrpc
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /vendor/piano-stock-qsee-system/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64

# Stock piano KeyMint HAL
#
# One process hosts IKeyMintDevice, IRemotelyProvisionedComponent,
# ISecureClock and ISharedSecret. It needs the stock vendor mount and a
# running qseecomd, so it stays disabled and is started manually during
# bring-up with: setprop ctl.start vendor.keymint
service vendor.keymint /vendor/bin/hw/piano-keymint
    class hal
    user system
    group system drmrpc
    disabled
    setenv LD_LIBRARY_PATH /vendor/piano-stock-qsee-system/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64
