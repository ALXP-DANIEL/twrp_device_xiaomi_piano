# Xiaomi Pad 8 Pro (piano) — TWRP 16 recovery init
#
# Minimal first image. Only what is needed to boot, light the panel, bring up
# USB and load the touch stack. None of the TWRP14 QSEE compatibility
# machinery is present: no stock vendor/odm mounts, no compatibility island,
# no binder symlinks, no secure-world services. Those return one at a time,
# each justified by an observed dependency.

on early-init
    # Stock vendor init mounts tracefs and makes its root searchable here.
    # Working stock qcrosvm holds trace_marker open for its default logger;
    # recovery otherwise has no trace_marker. No disk partition is involved.
    mount tracefs tracefs /sys/kernel/tracing
    chmod 0755 /sys/kernel/tracing

on init
    # Panel range is 0-4095, not 0-255. 200 here was ~5% and left the
    # splash barely visible before TWRP applies TW_DEFAULT_BRIGHTNESS.
    write /sys/class/backlight/panel0-backlight/brightness 2048
    setprop sys.usb.configfs 1
    # Mirrored from stock vendor build.prop. The secure services read these at
    # startup: is_security_level_spu selects the TrustZone-backed
    # implementation over SPU, retry_timer is the KeyMint startup retry
    # interval. Needed by phases 5 and 6, harmless before then.
    setprop vendor.gatekeeper.is_security_level_spu 0
    setprop vendor.keymint.retry_timer 5

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on boot
    setprop sys.usb.config adb

# Ramdisk files arrive labelled u:object_r:rootfs:s0. Apply the device
# file_contexts so init can perform the domain transition into u:r:tee:s0 when
# qseecomd is started; without this the binary stays rootfs-labelled and
# "ctl.start vendor.qseecomd" fails with PROP_ERROR_HANDLE_CONTROL_MESSAGE.
#
# task_profiles.json is restored for the same reason it is packaged: recovery
# ships cgroups.json but not task_profiles.json, so logd aborts in
# libprocessgroup, logcat stays empty, and every userspace SELinux denial
# becomes invisible - including the ones raised by servicemanager.
on early-fs
    restorecon /system/etc/task_profiles.json
    restorecon_recursive /system/etc/vintf
    restorecon /vendor/bin/piano-minkdaemon
    restorecon /vendor/bin/piano-ssgtzd
    restorecon_recursive /vendor/etc/ssg
    restorecon /vendor/bin/piano-qseecomd
    restorecon /vendor/bin/hw/piano-keymint
    restorecon /vendor/bin/hw/piano-gatekeeper
    restorecon /vendor/bin/hw/piano-weaver

    # Everything the stock binaries link must carry its real label, not the
    # rootfs label ramdisk files arrive with. u:r:tee:s0 cannot map or read a
    # rootfs file, which produced first
    #   avc: denied { map } path="/system/bin/linker64"   -> SIGSEGV
    # and then
    #   avc: denied { read } name="liblog.so"             -> exit status 1
    #
    # Listing individual libraries is guesswork - the set is whatever the stock
    # binaries happen to need. Relabel the directories wholesale instead.
    restorecon_recursive /system/bin

    # Packaged vendor binaries, for the same reason and one of its own.
    #
    # Labels in the recovery ramdisk are written at pack time, and a newly
    # added file_contexts entry does not always reach the cpio: the stock
    # virtualization service shipped as u:object_r:rootfs:s0 even though
    # /vendor/bin/piano-qvirt-service is labelled piano_qvirt_exec in every
    # generated file_contexts, including the one on the device. init then
    # refuses to start it outright:
    #
    #   Could not start service: File /vendor/bin/piano-qvirt-service
    #   (labeled "u:object_r:rootfs:s0") has incorrect label or no domain
    #   transition from u:r:init:s0 to another SELinux domain defined.
    #
    # Relabelling from the running policy makes the label deterministic
    # regardless of what the packer did, and covers every future prebuilt.
    restorecon_recursive /vendor/bin
    restorecon_recursive /vendor/lib64
    restorecon_recursive /vendor/etc
    restorecon_recursive /system/lib64
    restorecon /system/etc/ld.config.txt

# Xiaomi Pad 8 Pro host-touch stack.
#
# xiaomi_touch.ko must load before nt36532_touch.ko. The odm touch_report
# service is declared by the packaged /odm/etc/init/touch_report.rc.
on post-fs
    insmod /vendor/lib/modules/xiaomi_touch.ko
    insmod /vendor/lib/modules/nt36532_touch.ko
    start odm.touch_report

# Phase 3: read-only stock vendor and ODM views.
#
# The stock secure-world stack lives on the vendor and odm logical partitions.
# Both are mounted READ-ONLY so the recovery can link against them without any
# possibility of modifying the installed ROM. Unlike TWRP14, /vendor is
# writable in this recovery, so the mountpoints sit there rather than in /tmp.
#
# TWRP creates the logical-partition mapper links and then sets
# twrp.super.symlinks_created. The one-shot guard prevents a second mount
# attempt if the property is re-triggered.
#
# Nothing here touches persist, userdata or metadata.
on init
    setprop vendor.piano.stock.mounted 0

on property:twrp.super.symlinks_created=true && property:vendor.piano.stock.mounted=0
    setprop vendor.piano.stock.mounted 1
    mkdir /vendor/piano-stock 0755 root root
    mkdir /vendor/piano-stock-odm 0755 root root
    wait /dev/block/mapper/vendor${ro.boot.slot_suffix} 5
    mount erofs /dev/block/mapper/vendor${ro.boot.slot_suffix} /vendor/piano-stock ro
    wait /dev/block/mapper/odm${ro.boot.slot_suffix} 5
    mount erofs /dev/block/mapper/odm${ro.boot.slot_suffix} /vendor/piano-stock-odm ro

    # Binder pair consistency.
    #
    # The stock vendor partition ships libbinder.so but NOT libbinder_ndk.so.
    # With the stock path first on LD_LIBRARY_PATH the linker therefore takes
    # libbinder.so from stock and libbinder_ndk.so from the recovery, pairing
    # two different builds, and qseecomd dies loading its listener manager:
    #
    #   dlopen(libops.so) failed: cannot locate symbol
    #     "_ZN7android6binder2os22get_trace_enabled_tagsEv"
    #     referenced by "/system/lib64/libbinder_ndk.so"
    #
    # One symlink placed ahead of the stock path makes both halves come from
    # the recovery build. Everything else still resolves from stock vendor.
    # This is the TWRP16 equivalent of the TWRP14 binder-ABI finding, but it
    # needs a single library rather than a compatibility island.
    mkdir /vendor/piano-binder 0755 root root
    mkdir /vendor/piano-binder/lib64 0755 root root
    symlink /system/lib64/libbinder.so /vendor/piano-binder/lib64/libbinder.so

    # Recovery-only /dev/block/bootdevice alias. Stock QSEE expects this path;
    # recovery does not create it. Carried from the TWRP14 tree, where it was
    # established as a real device requirement rather than a compatibility
    # workaround.
    symlink /dev/block/platform/soc/1d84000.ufshc /dev/block/bootdevice

    # Secure stack start-up.
    #
    # These were started by hand through the Phase 4-7 bring-up. That stopped
    # being workable once crypto was enabled: metadata decryption happens inside
    # TWRP's Setup_Fstab_Partitions(), and on a clean boot KeyMint was simply not
    # running when it was asked for the key -
    #   Service android.hardware.security.keymint.IKeyMintDevice/default didn't start
    #   keystore2: failed to get interface ... Retry 4/5: NAME_NOT_FOUND
    # so decryption failed for want of a HAL rather than for any crypto reason.
    #
    # qseecomd is started here, at the END of this block, and not earlier: it
    # needs the stock vendor mount AND the binder symlink above. Started before
    # the symlink exists it loads stock's libbinder against the recovery's
    # libbinder_ndk and dies immediately, leaving init.svc.vendor.qseecomd
    # "stopped" with no listeners.
    #
    # No property gate is needed for the OS version and patch levels: they are
    # stamped at build time by PLATFORM_SECURITY_PATCH and friends in
    # BoardConfig.mk, so they are already correct before init starts anything.
    # The modem partition carries the GlobalPlatform trusted applications, and
    # Weaver is one of them. /vendor/firmware_mnt/image holds 57 TAs named by
    # UUID, including MiTEEProxyService and the gpqese TA, and ssgtzd looks for
    # them there. Without this mount the Weaver HAL comes up and registers, but
    # its first real call dies:
    #
    #   mi_weaver-impl: TEEC_InitializeContext() 0x00000000
    #   mi_weaver-impl: openSession ... Weaver GP TA : 0xFFFF0000
    #   mi_weaver-impl: TEEC_OpenSession() failed : 0xFFFF0000
    #   recovery: Failed to get weaver key size / Failed to decrypt user 0
    #
    # Read-only, and the modem partition is never written.
    mkdir /vendor/firmware_mnt 0771 system system
    wait /dev/block/by-name/modem${ro.boot.slot_suffix} 5
    mount vfat /dev/block/by-name/modem${ro.boot.slot_suffix} /vendor/firmware_mnt ro shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337
    mount none /vendor/firmware_mnt /firmware bind

    # MiTEE kernel driver.
    #
    # Xiaomi's Weaver TA lives behind MiTEE, not QSEE, and MiTEE's HLOS side
    # talks to the kernel through /dev/tee0 and /dev/teepriv0. Those nodes are
    # created by mitee_dlkm.ko, which ships on the vendor_dlkm logical
    # partition - a partition recovery never mounts. Without it the driver is
    # absent, the nodes do not exist, and every MiTEE session fails opaquely:
    #
    #   GPTEE: TEEC_InitializeContext: Loading module libGPMTEEC_vendor.so
    #   ssgtzd: Failed to construct Buffer from TA with uid
    #           8AAAF201-2460-0010-AABB-CCDD00000006 Error Code 3
    #   mi_weaver-impl: TEEC_OpenSession() failed : 0xFFFF0000  (openSession ret=11)
    #
    # Loading the module by hand produced the nodes immediately:
    #   mitee_dlkm: mitee_tee_init: mitee tee init
    #   mitee_dlkm: mitee_core_init: initialized driver
    #
    # The partition is mounted READ-ONLY and only the one module is loaded.
    mkdir /vendor/piano-stock-dlkm 0755 root root
    wait /dev/block/mapper/vendor_dlkm${ro.boot.slot_suffix} 5
    mount erofs /dev/block/mapper/vendor_dlkm${ro.boot.slot_suffix} /vendor/piano-stock-dlkm ro
    # mitee_dlkm is loaded from the on-boot block below, BEFORE the VM service,
    # mirroring measured stock order (module at 2.06s, VM 45 running at 13.16s).
    # The Gunyah resource manager publishes the VM message-queue capabilities
    # ONCE, as the VM starts; an RM notifier that registers after that moment
    # never receives them. Loading the module after VM 45 showed RUNNING left
    # gh_msgq_tx_5/rx_5 absent and Weaver dead with openSession ret=15, while
    # stock, which loads the module before its VM, gets active label-5 queues.
    # MiTEE logs the same init-time line on stock, so that line is transient.
    # The module is never unloaded: rmmod wedges the kernel while a TEE client
    # holds it.

    # Stock persist, READ-ONLY.
    #
    # Two consumers ask for it. qseecomd's DRM filesystem shim retries and then
    # gives up:
    #
    #   DrmLibFs: persist partition is not mounted, dispatch failed
    #
    # and MiTEE keeps its secure file storage at /mnt/vendor/persist/mitee/data
    # (stock labels that mitee_sfs_file and grants it to the tee domain).
    #
    # Mounted "ro" so nothing in recovery can alter DRM keys, calibration or
    # any other persist content. The partition is never written, never
    # formatted and never fsck'd here: the stock entry carries "check", and
    # that is deliberately not reproduced.
    mkdir /mnt/vendor 0771 root system
    mkdir /mnt/vendor/persist 0771 root system
    wait /dev/block/by-name/persist 5
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist ro nosuid nodev noatime

    # The trustedvm guest VM's two disks.
    #
    # MiTEE runs inside a Gunyah guest VM named "trustedvm", whose root
    # filesystem is /product/firmware/vm-system/system.img on the product
    # partition and whose persistent image is
    # /mnt/product/vm-persist/trustedvm/persist.img on the vm-persist
    # partition. The virtualization service reads both paths literally out of
    # /vendor/etc/qvirtmgr-vndr.json, so both have to appear at exactly those
    # locations.
    #
    # Both are mounted READ-ONLY. The stock config marks persist.img
    # "read_write": true, so the VM may well refuse to boot this way; that is
    # deliberate for now, because a read-only attempt cannot damage the image
    # and the failure will say plainly whether write access is really needed.
    # vm-persist is a different partition from persist and neither is written
    # here.
    # Mounted under /vendor, NOT at /product.
    #
    # TWRP manages the logical partitions itself and unmounts /product during
    # its own partition setup, which silently removes the VM's root filesystem
    # after init has mounted it. The symptom is an ENOENT with no context:
    #
    #   qcrosvm: Error parsing arguments InvalidValue {
    #     value: "/product/firmware/vm-system/system.img,label=10,rw=false",
    #     expected: "an existing file" }
    #
    # The packaged qvirtmgr-vndr.json is patched to match these paths, so the
    # VM disks live somewhere TWRP has no reason to touch.
    mkdir /vendor/piano-stock-product 0755 root root
    wait /dev/block/mapper/product${ro.boot.slot_suffix} 20
    mount erofs /dev/block/mapper/product${ro.boot.slot_suffix} /vendor/piano-stock-product ro

    # The virtualization service does not boot the VM itself. It forks
    # /system_ext/bin/qcrosvm, a crosvm-derived VMM, and that process opens the
    # Gunyah device and attaches the VM's disks. Without this mount the fork
    # fails and the only symptom is a launch that quietly does nothing.
    mkdir /system_ext 0755 root root
    wait /dev/block/mapper/system_ext${ro.boot.slot_suffix} 20
    # context= relabels the whole mount to a type this policy owns. qcrosvm and
    # its seccomp policy both live here; the policy file carries system_file in
    # its own xattrs, and a platform neverallow forbids a vendor domain from
    # reading that type (domain.te:1238). Relabelling at mount time reaches it
    # without widening policy, exactly as for the VM disks.
    mount erofs /dev/block/mapper/system_ext${ro.boot.slot_suffix} /system_ext ro context=u:object_r:vendor_qcrosvm_exec:s0

    # Stock system, READ-ONLY.
    #
    # qcrosvm is a Rust binary and its dylibs -- libdevices, libstd,
    # libbase_rust, libdisk, libvm_memory, libcros_async and the rest -- live in
    # the stock /system/lib64, of which there are 227. Recovery replaces /system
    # with its own ramdisk, so none of them are reachable and the VMM dies
    # before main():
    #
    #   CANNOT LINK EXECUTABLE "/system_ext/bin/qcrosvm":
    #   library "libdevices.dylib.so" not found: needed by main executable
    #
    # Mounted beside the other stock views rather than over /system, which must
    # stay the recovery's own. The service's LD_LIBRARY_PATH points here.
    mkdir /vendor/piano-stock-system 0755 root root
    wait /dev/block/mapper/system${ro.boot.slot_suffix} 20
    mount erofs /dev/block/mapper/system${ro.boot.slot_suffix} /vendor/piano-stock-system ro
    mkdir /vendor/piano-stock-vmpersist 0755 root root
    wait /dev/block/by-name/vm-persist 20
    # context= overrides every label on the partition with one this policy
    # owns. The persist image carries mnt_product_file in its own xattrs, and a
    # platform neverallow forbids a vendor domain from touching that type, so
    # relabelling at mount time is the only way to reach it without widening
    # policy.
    mount ext4 /dev/block/by-name/vm-persist /vendor/piano-stock-vmpersist ro nosuid nodev noatime context=u:object_r:vendor_vm_qti_system_file:s0

    start vendor.qseecomd

    # The HLOS Mink opener. Xiaomi's Weaver does not go through QSEE at all:
    # libmi_weaver -> libGPTEE_vendor -> libGPMTEEC_vendor -> libminksocket.
    # Without this daemon serving the HLOSMINKD interface, the Weaver TA session
    # cannot be opened and TWRP reports "Failed to get weaver key size" long
    # before it looks at the credential.
    start vendor.minkdaemon

    # The virtualization service, which brings up trustedvm and with it MiTEE.
    # Started last in this block because it needs both VM disks mounted above.
    #
    # sys.boot_completed gates the whole thing. qvirtservice's autostart handler
    # reads it and waits: with the property unset the launch thread logs
    # "Launching trustedvm" and then does nothing at all -- no VMM fork, no
    # device opened, no error. Recovery never completes an Android boot, so the
    # property is never set by anything else.
    #
    # This is a real precondition of the VM manager, not a test being forced to
    # pass. Nothing else in this recovery reads sys.boot_completed.
    setprop sys.boot_completed 1
    # NOTE: stock /odm is deliberately NOT bound over /odm.
    #
    # firmware_class defaults to searching /odm/firmware/..., and an early
    # version of this file bound the stock odm view there to satisfy it. That
    # hides the recovery's OWN /odm, which carries the packaged touch stack --
    # touch_report.rc and the touch libraries -- so the device booted to the
    # TWRP splash with no UI and a load average above 11.
    #
    # It is unnecessary anyway: the guest's blobs are symlinked into the
    # recovery's own /odm/firmware/o8 below, the active firmware directory.

    # vm-bootsys, which carries the guest's signed kernel.
    #
    # trustedvm.mdt and its .b00-.bNN segments live on this partition and
    # nowhere else: they are not on system, vendor, odm, product, system_ext or
    # modem. Without it the loader reports
    #   Direct firmware load for trustedvm.mdt failed with error -2
    # and the VM cannot be authenticated. The partition is mounted READ-ONLY;
    # symlinks below expose its blobs without changing the firmware search path.
    mkdir /vendor/piano-stock-vmboot 0755 root root
    wait /dev/block/by-name/vm-bootsys${ro.boot.slot_suffix} 20
    mount ext4 /dev/block/by-name/vm-bootsys${ro.boot.slot_suffix} /vendor/piano-stock-vmboot ro nosuid nodev noatime context=u:object_r:piano_vmboot_file:s0
    # The guest's blobs are linked into the active firmware directory,
    # /odm/firmware/o8 (verified in firmware_class/parameters/path).
    # Links in its parent left trustedvm.mdt unreachable: the first loader
    # attempt returned ENOENT; retries reported the VMID already allocated.
    # Preserve the selected path and its existing Novatek touch firmware.
    # Pointing that path at vm-bootsys previously broke touch firmware loading.
    symlink /vendor/piano-stock-vmboot/trustedvm/boot/trustedvm.mdt /odm/firmware/o8/trustedvm.mdt
    symlink /vendor/piano-stock-vmboot/trustedvm/boot/trustedvm.b00 /odm/firmware/o8/trustedvm.b00
    symlink /vendor/piano-stock-vmboot/trustedvm/boot/trustedvm.b01 /odm/firmware/o8/trustedvm.b01
    symlink /vendor/piano-stock-vmboot/trustedvm/boot/trustedvm.b02 /odm/firmware/o8/trustedvm.b02
    symlink /vendor/piano-stock-vmboot/trustedvm/boot/trustedvm.b03 /odm/firmware/o8/trustedvm.b03
    symlink /vendor/piano-stock-vmboot/trustedvm/boot/trustedvm.b04 /odm/firmware/o8/trustedvm.b04

    # The guest's persist image is opened READ-WRITE by qcrosvm
    # ("read_write": true in qvirtmgr-vndr.json), but vm-persist is mounted
    # read-only here and stays that way: nothing in this recovery writes to a
    # real partition. A RAM copy on the ramdisk is handed to the VM instead, so
    # guest writes land in memory and the partition is never touched. The copy
    # is discarded at reboot, which is correct for recovery - no guest state
    # from a recovery session should survive into the running system.
    mkdir /vendor/piano-vm-rw 0700 root root
    copy /vendor/piano-stock-vmpersist/trustedvm/persist.img /vendor/piano-vm-rw/persist.img
    chmod 0600 /vendor/piano-vm-rw/persist.img
    restorecon_recursive /vendor/piano-vm-rw

    # MiTEE is loaded BEFORE the VM service, mirroring measured stock order
    # (module at 2.06s, VM 45 running at 13.16s). The Gunyah resource manager
    # publishes the VM's message-queue capabilities ONCE, as the VM starts. A
    # module that is not yet registered as an RM notifier at that moment never
    # receives them: loading MiTEE after the VM showed RUNNING left
    # gh_msgq_tx_5/rx_5 absent and Weaver dead with openSession ret=15.
    # MiTEE's own init logs "msgq didn't set up, try later" on stock too, and
    # stock's queues then activate when the VM notification arrives -- the
    # message is transient, not a failure. The module is never unloaded:
    # rmmod wedges the kernel while a TEE client holds it.
    insmod /vendor/piano-stock-dlkm/lib/modules/mitee_dlkm.ko
    start vendor.qvirtservice
    start vendor.piano_vmwatch


# The other three need qseecomd's listeners, which it announces itself. Chaining
# on its own signal avoids a sleep, and each service still starts exactly once
# because they remain "disabled" and nothing else starts them.
on property:vendor.sys.listeners.registered=true
    start vendor.ssgtzd
    start vendor.keymint
    start vendor.gatekeeper_default

# Weaver waits for the Mink opener's socket rather than for qseecomd's listeners:
# its TA lives behind MiTEE, so the QSEE listeners say nothing about whether it
# can be reached.
# Weaver is no longer started from the Mink daemon's signal. The Mink opener
# being up says nothing about whether MiTEE can be reached: the TA lives inside
# the trustedvm guest, and starting Weaver before that guest exists is exactly
# what produced openSession ret=15. It now starts from the
# vendor.piano.vm.running trigger at the bottom of this file.

# Phase 4: stock Qualcomm TEE daemon.
#
# Packaged unmodified from HyperOS 3 (SHA-256
# dc1ccdd0a32891f0f38048383499e8849e071840ef5bb210eefa1b0e3b2c369f). Both this
# recovery and the stock binary are Android 16, so no compatibility island is
# packaged: the point of the TWRP16 migration is that none should be needed.
# If an exact missing symbol proves otherwise, that evidence justifies adding
# one library, not a wholesale port of the TWRP14 stack.
#
# Kept "disabled" so that only the vendor.piano.stock.mounted trigger above
# starts it, exactly once per recovery boot, after the stock vendor mount.
service vendor.qseecomd /vendor/bin/piano-qseecomd
    class core
    user root
    group root drmrpc
    socket notify-topology stream 0660 system drmrpc
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64


# Phase 5: stock piano KeyMint HAL.
#
# One process hosts IKeyMintDevice, IRemotelyProvisionedComponent,
# ISecureClock and ISharedSecret. It needs the stock vendor mount and a
# running qseecomd, so it stays "disabled" and is started by the
# vendor.sys.listeners.registered trigger above, which is qseecomd's own
# announcement that its listeners are up.
#
# Same LD_LIBRARY_PATH as qseecomd, including the binder symlink directory:
# this binary links libbinder_ndk too, so the pair must match for the same
# reason qseecomd's did.
service vendor.keymint /vendor/bin/hw/piano-keymint
    class hal
    user system
    group system drmrpc
    disabled
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64


# Phase 6: stock piano Gatekeeper HAL.
#
# Stock enables this when vendor.gatekeeper.is_security_level_spu=0, which
# init sets above. Started only after QSEE listeners are confirmed healthy, by
# the vendor.sys.listeners.registered trigger.
service vendor.gatekeeper_default /vendor/bin/hw/piano-gatekeeper
    class early_hal
    user system
    group system
    disabled
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64

# Phase 7: stock piano Xiaomi Weaver HAL.
#
# libmi_weaver.so is odm-private, hence the extra odm path. Started by the
# vendor.sys.listeners.registered trigger, like the other two.
service vendor.weaver /vendor/bin/hw/piano-weaver
    class hal
    user system
    group system drmrpc
    disabled
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock-odm/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64


# Qualcomm's GlobalPlatform trusted-application loader.
#
# Weaver is a GP TA, not a QSEE listener, so qseecomd alone is not enough: the TA
# has to be loaded from the modem partition mounted above, and ssgtzd is what
# loads it. Without it TEEC_OpenSession fails and the credential can never be
# checked - TWRP reports "Failed to get weaver key size" and gives up before it
# ever looks at the PIN, which is why no retry attempt was consumed by the
# failures.
#
# Definition copied from the stock /vendor/etc/init/ssgtzd.rc, including the
# capabilities and both sockets. Stock starts it from an early-boot trigger; here
# it starts with the rest of the secure stack, after qseecomd's listeners are up.
service vendor.ssgtzd /vendor/bin/piano-ssgtzd
    class late_start
    user system
    group system oem_2912 wakelock
    capabilities WAKE_ALARM BLOCK_SUSPEND
    disabled
    socket ssgtzd stream 0660 system oem_2912
    socket ssgtzd_opener stream 0660 system system
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64


# Stock HLOS Mink daemon, the opener libGPMTEEC_vendor needs to reach a
# GlobalPlatform TA through MiTEE.
#
# The socket name is the one the daemon looks for: it logs
#   Did not find env var with sock fd for ANDROID_SOCKET_hlos_mink_opener
#   Using file /dev/socket/hlos_mink_opener
# and falls back to the file, so init creates it under that exact name.
#
# Runs in the tee domain like the other secure daemons — it is a client of the
# same secure world.
service vendor.minkdaemon /vendor/bin/piano-minkdaemon
    class core
    user system
    group system drmrpc
    disabled
    socket hlos_mink_opener stream 0660 system drmrpc
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64

# Stock Qualcomm virtualization service.
#
# Packaged from the stock product partition (SHA-256
# bcc03258a6d597695322e4c21f88aced910da15fac31c044ebb06c3feffbb711) as
# /vendor/bin/piano-qvirt-service. Its config is the stock
# qvirtmgr-vndr.json, in which trustedvm carries "autostart": true, so the
# service launches the VM itself on start and exits once startup completes --
# hence oneshot, matching the stock product init file.
#
# Runs as root: the stock service does, and creating loopback devices for the
# VM disks requires it.
service vendor.qvirtservice /vendor/bin/piano-qvirt-service
    class core
    user root
    group root system
    disabled
    oneshot
    # qcrosvm inherits this environment, and the ORDER here is load-bearing.
    #
    # Stock system must come before stock vendor. With vendor first, a stock
    # system library resolves one of its own dependencies against a recovery
    # library that does not carry the symbol:
    #
    #   CANNOT LINK EXECUTABLE "/system_ext/bin/qcrosvm": cannot locate symbol
    #   "_ZN7android25MEDIA_MIMETYPE_AUDIO_IAMFE" referenced by
    #   ".../piano-stock-system/system/lib64/libaudioclient_aidl_conversion.so"
    #
    # which is the Phase 4 binder-pair law in a new place: one interface, two
    # builds. The recovery's own binder pair still comes first, so that fix
    # holds; everything else resolves stock-first. Both orders were tested on
    # the device before this line was written.
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock-system/system/lib64:/system_ext/lib64:/vendor/piano-stock/lib64:/vendor/lib64:/system/lib64

# Weaver's start is gated on VM readiness or timeout; MiTEE is loaded earlier,
# before the VM service, so its resource-manager notifier catches the message
# queue capabilities published once as VM 45 starts (see the insmod block).
on property:vendor.piano.vm.running=1
    start vendor.weaver

# The watcher publishes 0 when the VM does not come up in time. Weaver is still
# started in that case, deliberately. TWRP's credential path blocks in a
# one-second retry loop waiting for IWeaver/default to appear on servicemanager,
# and if the service is never started at all that loop does not terminate: the
# UI never renders its first page and the screen stays blank. Started and
# failing, Weaver returns an error and TWRP falls through to its normal
# "no Weaver" path with a usable UI.
on property:vendor.piano.vm.running=0
    start vendor.weaver

service vendor.piano_vmwatch /vendor/bin/piano-mitee-start.sh
    class core
    user root
    group root system
    disabled
    oneshot
