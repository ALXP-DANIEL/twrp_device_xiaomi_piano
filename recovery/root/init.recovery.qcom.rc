# Xiaomi Pad 8 Pro (piano) — TWRP 16 recovery init
#
# Minimal first image. Only what is needed to boot, light the panel, bring up
# USB and load the touch stack. None of the TWRP14 QSEE compatibility
# machinery is present: no stock vendor/odm mounts, no compatibility island,
# no binder symlinks, no secure-world services. Those return one at a time,
# each justified by an observed dependency.

on init
    # Panel range is 0-4095, not 0-255. 200 here was ~5% and left the
    # splash barely visible before TWRP applies TW_DEFAULT_BRIGHTNESS.
    write /sys/class/backlight/panel0-backlight/brightness 2048
    setprop sys.usb.configfs 1
    # Mirrored from stock vendor build.prop. The secure services read these at
    # startup: is_security_level_spu selects the TrustZone-backed
    # implementation over SPU, retry_timer is the KeyMint startup retry
    # interval. Needed by phases 5 and 6, harmless before then.
    setprop vendor.gatekeeper.is_security_level_spu 0
    setprop vendor.keymint.retry_timer 5

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on boot
    setprop sys.usb.config adb

# Ramdisk files arrive labelled u:object_r:rootfs:s0. Apply the device
# file_contexts so init can perform the domain transition into u:r:tee:s0 when
# qseecomd is started; without this the binary stays rootfs-labelled and
# "ctl.start vendor.qseecomd" fails with PROP_ERROR_HANDLE_CONTROL_MESSAGE.
#
# task_profiles.json is restored for the same reason it is packaged: recovery
# ships cgroups.json but not task_profiles.json, so logd aborts in
# libprocessgroup, logcat stays empty, and every userspace SELinux denial
# becomes invisible - including the ones raised by servicemanager.
on early-fs
    restorecon /system/etc/task_profiles.json
    restorecon_recursive /system/etc/vintf
    restorecon /vendor/bin/piano-qseecomd
    restorecon /vendor/bin/hw/piano-keymint

    # Everything the stock binaries link must carry its real label, not the
    # rootfs label ramdisk files arrive with. u:r:tee:s0 cannot map or read a
    # rootfs file, which produced first
    #   avc: denied { map } path="/system/bin/linker64"   -> SIGSEGV
    # and then
    #   avc: denied { read } name="liblog.so"             -> exit status 1
    #
    # Listing individual libraries is guesswork - the set is whatever the stock
    # binaries happen to need. Relabel the directories wholesale instead.
    restorecon_recursive /system/bin
    restorecon_recursive /system/lib64
    restorecon /system/etc/ld.config.txt

# Xiaomi Pad 8 Pro host-touch stack.
#
# xiaomi_touch.ko must load before nt36532_touch.ko. The odm touch_report
# service is declared by the packaged /odm/etc/init/touch_report.rc.
on post-fs
    insmod /vendor/lib/modules/xiaomi_touch.ko
    insmod /vendor/lib/modules/nt36532_touch.ko
    start odm.touch_report

# Phase 3: read-only stock vendor and ODM views.
#
# The stock secure-world stack lives on the vendor and odm logical partitions.
# Both are mounted READ-ONLY so the recovery can link against them without any
# possibility of modifying the installed ROM. Unlike TWRP14, /vendor is
# writable in this recovery, so the mountpoints sit there rather than in /tmp.
#
# TWRP creates the logical-partition mapper links and then sets
# twrp.super.symlinks_created. The one-shot guard prevents a second mount
# attempt if the property is re-triggered.
#
# Nothing here touches persist, userdata or metadata.
on init
    setprop vendor.piano.stock.mounted 0

on property:twrp.super.symlinks_created=true && property:vendor.piano.stock.mounted=0
    setprop vendor.piano.stock.mounted 1
    mkdir /vendor/piano-stock 0755 root root
    mkdir /vendor/piano-stock-odm 0755 root root
    wait /dev/block/mapper/vendor${ro.boot.slot_suffix} 5
    mount erofs /dev/block/mapper/vendor${ro.boot.slot_suffix} /vendor/piano-stock ro
    wait /dev/block/mapper/odm${ro.boot.slot_suffix} 5
    mount erofs /dev/block/mapper/odm${ro.boot.slot_suffix} /vendor/piano-stock-odm ro

    # Binder pair consistency.
    #
    # The stock vendor partition ships libbinder.so but NOT libbinder_ndk.so.
    # With the stock path first on LD_LIBRARY_PATH the linker therefore takes
    # libbinder.so from stock and libbinder_ndk.so from the recovery, pairing
    # two different builds, and qseecomd dies loading its listener manager:
    #
    #   dlopen(libops.so) failed: cannot locate symbol
    #     "_ZN7android6binder2os22get_trace_enabled_tagsEv"
    #     referenced by "/system/lib64/libbinder_ndk.so"
    #
    # One symlink placed ahead of the stock path makes both halves come from
    # the recovery build. Everything else still resolves from stock vendor.
    # This is the TWRP16 equivalent of the TWRP14 binder-ABI finding, but it
    # needs a single library rather than a compatibility island.
    mkdir /vendor/piano-binder 0755 root root
    mkdir /vendor/piano-binder/lib64 0755 root root
    symlink /system/lib64/libbinder.so /vendor/piano-binder/lib64/libbinder.so

    # Recovery-only /dev/block/bootdevice alias. Stock QSEE expects this path;
    # recovery does not create it. Carried from the TWRP14 tree, where it was
    # established as a real device requirement rather than a compatibility
    # workaround.
    symlink /dev/block/platform/soc/1d84000.ufshc /dev/block/bootdevice

# Phase 4: stock Qualcomm TEE daemon.
#
# Packaged unmodified from HyperOS 3 (SHA-256
# dc1ccdd0a32891f0f38048383499e8849e071840ef5bb210eefa1b0e3b2c369f). Both this
# recovery and the stock binary are Android 16, so no compatibility island is
# packaged: the point of the TWRP16 migration is that none should be needed.
# If an exact missing symbol proves otherwise, that evidence justifies adding
# one library, not a wholesale port of the TWRP14 stack.
#
# Disabled deliberately. Started manually, exactly once per recovery boot:
#     setprop ctl.start vendor.qseecomd
service vendor.qseecomd /vendor/bin/piano-qseecomd
    class core
    user root
    group root drmrpc
    socket notify-topology stream 0660 system drmrpc
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64


# Phase 5: stock piano KeyMint HAL.
#
# One process hosts IKeyMintDevice, IRemotelyProvisionedComponent,
# ISecureClock and ISharedSecret. It needs the stock vendor mount and a
# running qseecomd, so it stays disabled and is started manually during
# bring-up with: setprop ctl.start vendor.keymint
#
# Same LD_LIBRARY_PATH as qseecomd, including the binder symlink directory:
# this binary links libbinder_ndk too, so the pair must match for the same
# reason qseecomd's did.
service vendor.keymint /vendor/bin/hw/piano-keymint
    class hal
    user system
    group system drmrpc
    disabled
    setenv LD_LIBRARY_PATH /vendor/piano-binder/lib64:/vendor/piano-stock/lib64:/vendor/piano-stock/lib64/hw:/system/lib64
